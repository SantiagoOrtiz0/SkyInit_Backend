# Copia este archivo como .env y completa los valores. NUNCA subas el .env a git.
ENV=development                 # production activa cookies Secure

# Base de datos (MariaDB / MySQL)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=skyinit_app
DB_PASS=
DB_NAME=skyinit

# Sesion: minimo 32 caracteres.  Generar con:  openssl rand -hex 32
SECRET_KEY=
SERVER=http://localhost:8001
FRONTEND_URL=http://localhost:4321

# Correo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Acceso con Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8001/auth/google/callback

# Recordatorios de citas: true envia tambien correo; siempre hay aviso dentro de la app
RECORDATORIOS_EMAIL=false
RECORDATORIO_HORAS=24
